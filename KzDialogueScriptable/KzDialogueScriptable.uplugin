	"VersionName": "1.0",
	"FriendlyName": "KzDialogue - Scriptable Framework Integration",
	"Description": "Adds dialogue tasks to the Scriptable Framework: play a dialogue line, a whole dialogue asset or a dialogue graph, finishing when it ends and stopping it when the task stops. Requires the ScriptableFramework plugin.",
	"Category": "Gameplay",
	"CreatedBy": "kirzo",
	"CreatedByURL": "https://kirzo.dev",
	"DocsURL": "https://github.com/kirzo/KzDialogue",
	"MarketplaceURL": "",
	"SupportURL": "",
	"EnabledByDefault": false,
	"CanContainContent": false,
	"IsBetaVersion": false,
	"IsExperimentalVersion": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "KzDialogueScriptable",
			"Type": "Runtime",
			"LoadingPhase": "Default"
		}
	],
	"Plugins": [
		{
			"Name": "KzDialogue",
			"Enabled": true
		},
		{
			"Name": "ScriptableFramework",
			"Enabled": true
		}
	]
}